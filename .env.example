# Telegram Bot Token (from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Google AI Studio API Key (free tier — get yours at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Shop Details (used on invoices)
SHOP_NAME=My Kirana Store
SHOP_GSTIN=27AABCU9603R1ZX
SHOP_ADDRESS=123, Main Bazaar, Mumbai, MH 400001
SHOP_PHONE=9876543210

# Gemini model to use (free-tier Flash models; verify current aliases with: client.models.list())
GEMINI_MODEL=gemini-2.5-flash

# SQLite DB path (relative to project root)
DB_PATH=data/supermarket.db

# Allowed Telegram user IDs (comma-separated). Leave empty to allow all.
ALLOWED_USER_IDS=

# Log level
LOG_LEVEL=INFO
